s_!iZcA!,w_128,h_128,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fc991958e-a282-4a74-83e6-4f02e5866183_144x144.png"},"image":{"@type":"ImageObject","url":"https://substackcdn.com/image/fetch/$s_!iZcA!,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fc991958e-a282-4a74-83e6-4f02e5866183_144x144.png","contentUrl":"https://substackcdn.com/image/fetch/$s_!iZcA!,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fc991958e-a282-4a74-83e6-4f02e5866183_144x144.png","thumbnailUrl":"https://substackcdn.com/image/fetch/$s_!iZcA!,w_128,h_128,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fc991958e-a282-4a74-83e6-4f02e5866183_144x144.png"}},"interactionStatistic":[{"@type":"InteractionCounter","interactionType":"https://schema.org/LikeAction","userInteractionCount":0},{"@type":"InteractionCounter","interactionType":"https://schema.org/ShareAction","userInteractionCount":0},{"@type":"InteractionCounter","interactionType":"https://schema.org/CommentAction","userInteractionCount":0}]}</script><script nonce="GBg24Hqi4gAuZw6HnHQcTw" type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"xbill's Substack","item":"https://xbill9.substack.com"},{"@type":"ListItem","position":2,"name":"Streamline Publishing with a Claude Code Skill","item":"https://xbill9.substack.com/p/streamline-publishing-with-a-claude"}]}</script><div class="single-post-container" aria-label="Post" role="main"><div class="container"><div class="single-post"><div class="pencraft pc-display-contents pc-reset pubTheme-yiXxQA"><article class="typography newsletter-post post"><div class="post-header" role="region" aria-label="Post header"><h1 class="post-title published title-X77sOw" dir="auto">Streamline Publishing with a Claude Code Skill</h1><h3 class="subtitle subtitle-HEEcLo" dir="auto">A Claude Code skill that turns one markdown file into dev.to, AWS Builder Center, Medium and LinkedIn versions, checks them before they ship, and posts the ones with an API — plus the debugging tools for when a destination mangles something.</h3><div class="pencraft pc-display-flex pc-flexDirection-column pc-paddingBottom-16 pc-reset" aria-label="Post UFI" role="region"><div class="pencraft pc-display-flex pc-paddingY-16 pc-justifyContent-space-between pc-alignItems-center pc-reset"><div class="pencraft pc-display-flex pc-gap-12 pc-alignItems-center pc-reset byline-wrapper"><div class="pencraft pc-display-flex pc-reset"><div class="pencraft pc-display-flex pc-flexDirection-row pc-gap-8 pc-alignItems-center pc-justifyContent-flex-start pc-reset"><div style="--scale:36px;--offset:9px;--border-width:4.5px" class="pencraft pc-display-flex pc-flexDirection-row pc-alignItems-center pc-justifyContent-flex-start pc-reset ltr-qDBmby"><a href="https://substack.com/@xbill99" aria-label="View xbill&#x27;s profile" class="pencraft pc-display-contents pc-reset"><div class="pencraft pc-display-flex pc-width-36 pc-height-36 pc-justifyContent-center pc-alignItems-center pc-position-relative pc-reset bg-secondary-zsvint flex-auto-Ui4XB2 animate-o2cZpX outline-detail-MZomZU pc-borderRadius-full overflow-hidden-aKGHtM sizing-border-box-tYLTRQ pressable-sm-lfVyam showFocus-WVN5uq container-TAtrWj interactive-UkK0V6 avatar-u8q6xB last-JfNEJ_" style="--scale:36px" tabindex="0"><div class="pencraft pc-display-flex pc-width-36 pc-height-36 pc-justifyContent-center pc-alignItems-center pc-position-relative pc-reset bg-secondary-zsvint flex-auto-Ui4XB2 outline-detail-MZomZU pc-borderRadius-full overflow-hidden-aKGHtM sizing-border-box-tYLTRQ container-TAtrWj" style="--scale:36px" title="xbill"><picture><source type="image/webp" srcSet="https://substackcdn.com/image/fetch/$